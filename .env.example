# Application
APP_NAME=Hybrid Notebook API
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://notebook:notebook@localhost:5432/notebook

# Embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Search
SEMANTIC_SEARCH_DEFAULT_TOP_K=5
SEMANTIC_SEARCH_MAX_TOP_K=50
